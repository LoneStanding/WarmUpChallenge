# SECURITY NOTICE: Never commit your actual .env file to version control.
# Copy this file to .env and fill in your keys.

# 1. Provide your Gemini API Key here. 
# It will be securely kept on the server and never exposed to the frontend app.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/firebase-adminsdk.json
GEMINI_API_KEY=paste_your_gemini_api_key_here

# 2. Database Storage (Optional)
# If deployed on Google Cloud Run, Firestore automatically authenticates.
# If running locally, provide the absolute path to your GCP service account JSON to use Firestore.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/firebase-adminsdk.json
